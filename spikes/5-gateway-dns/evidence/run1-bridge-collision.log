## 5. two gateways at once; default network untouched
-- ctl: up 192.168.64.1
up 192.168.65.1
  fl5-a1 fl5-probe ->ERROR
  fl5-b1 fl5-probe -> 10.55.55.55
  fl5-d1 fl5-probe -> NXDOMAIN
  fl5-d1 example.com -> 104.20.23.154 172.66.147.243
-- helper log (new lines)
   21:28:54 192.168.65.1: BOUND SO_REUSEADDR (plain bind got EADDRINUSE)
   21:29:00 192.168.65.2 -> 192.168.65.1 fl5-probe type=1 probe
## 6. guest restart with the helper holding fl5_a
-- ctl: up 192.168.64.1

$ container stop fl5-a1
fl5-a1
[exit 0]
