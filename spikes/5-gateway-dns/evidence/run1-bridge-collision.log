## 1. setup: a1 on fl5_a, b1 on fl5_b, d1 on default; baseline via mDNSResponder
gateways: a=192.168.64.1 b=192.168.65.1 default=192.168.66.1
  fl5-a1 example.com ->ERROR
  fl5-a1 fl5-probe ->ERROR
  fl5-b1 example.com -> 104.20.23.154 172.66.147.243
  fl5-b1 fl5-probe -> NXDOMAIN
  fl5-d1 example.com -> 104.20.23.154 172.66.147.243
  fl5-d1 fl5-probe -> NXDOMAIN
-- :53 sockets
   udp6 *.53
   udp4 *.53
## 2. helper binds fl5_a's gateway only
-- ctl: up 192.168.64.1
-- :53 sockets
   udp6 *.53
   udp4 *.53
-- helper log (new lines)
   21:24:29 192.168.64.1: waiting: address not on any interface
  fl5-a1 fl5-probe ->ERROR
  fl5-a1 example.com ->ERROR
  fl5-b1 fl5-probe -> NXDOMAIN
  fl5-b1 example.com -> 104.20.23.154 172.66.147.243
  fl5-d1 fl5-probe -> NXDOMAIN
  fl5-d1 example.com -> 104.20.23.154 172.66.147.243
-- helper log (new lines)
## 3. helper releases: fl5_a falls straight back to mDNSResponder
-- ctl: <empty>
  fl5-a1 example.com ->ERROR
  fl5-a1 fl5-probe ->ERROR
-- :53 sockets
   udp6 *.53
   udp4 *.53
-- helper log (new lines)
