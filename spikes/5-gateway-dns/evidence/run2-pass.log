## 1. setup: d1 on default first (holds its bridge, avoids apple/container#2051), then a1 on fl5_a, b1 on fl5_b
gateways: a=192.168.64.1 b=192.168.65.1 default=192.168.66.1
-- host bridges: bridge100: 192.168.66.1 bridge101: 192.168.64.1 bridge102: 192.168.65.1 
  fl5-a1 example.com -> 172.66.147.243 104.20.23.154
  fl5-a1 fl5-probe -> NXDOMAIN
  fl5-b1 example.com -> 172.66.147.243 104.20.23.154
  fl5-b1 fl5-probe -> NXDOMAIN
  fl5-d1 example.com -> 172.66.147.243 104.20.23.154
  fl5-d1 fl5-probe -> NXDOMAIN
-- :53 sockets
   udp6 *.53
   udp4 *.53
## 2. helper binds fl5_a's gateway only
-- ctl: up 192.168.64.1
-- :53 sockets
   udp4 192.168.64.1.53
   udp6 *.53
   udp4 *.53
