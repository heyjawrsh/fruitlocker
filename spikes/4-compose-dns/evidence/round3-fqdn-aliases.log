## 1. networks (one per Compose network)

$ container network create pa_default
pa_default
[exit 0]

$ container network create pa_back
pa_back
[exit 0]

$ container network create pb_default
pb_default
[exit 0]
## 2. containers: same service name 'db' in two projects

$ container run -d --name pa-db-1 --dns-search pa.fruitlocker.internal --network pa_default,alias=db.pa.fruitlocker.internal,alias=postgres.pa.fruitlocker.internal alpine:3.20 sleep 900
pa-db-1
[exit 0]

$ container run -d --name pa-web-1 --dns-search pa.fruitlocker.internal --network pa_default,alias=web.pa.fruitlocker.internal alpine:3.20 sleep 900
pa-web-1
[exit 0]

$ container run -d --name pb-db-1 --dns-search pb.fruitlocker.internal --network pb_default,alias=db.pb.fruitlocker.internal alpine:3.20 sleep 900
pb-db-1
[exit 0]

$ container run -d --name pa-multi-1 --dns-search pa.fruitlocker.internal --network pa_default,alias=multi.pa.fruitlocker.internal --network pa_back,alias=multi-back.pa.fruitlocker.internal alpine:3.20 sleep 900
pa-multi-1
[exit 0]

$ container ls
ID          IMAGE                          OS     ARCH   STATE    IP                               CPUS  MEMORY   STARTED
