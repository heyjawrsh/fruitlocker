[exit 0]
## 5. reachability

$ container exec pa-web-1 ping -c1 -W2 db
ping: bad address 'db'
[exit 1]

$ container exec pb-db-1 ping -c1 -W2 db.pa.fruitlocker.internal
ping: bad address 'db.pa.fruitlocker.internal'
[exit 1]

$ container exec pa-multi-1 ping -c1 -W2 db
ping: bad address 'db'
[exit 1]
## 6. published port + service-to-service HTTP

$ container run -d --name pa-http-1 --dns-search pa.fruitlocker.internal --network pa_default,alias=http.pa.fruitlocker.internal -p 127.0.0.1:18080:8080 alpine:3.20 sh -c mkdir -p /w && echo fruitlocker-ok > /w/index.html && httpd -f -p 8080 -h /w
pa-http-1
[exit 0]

$ curl -s -m 5 http://127.0.0.1:18080/
[exit 7]

$ container exec pa-web-1 wget -qO- -T 3 http://http:8080/
wget: bad address 'http:8080'
[exit 1]
